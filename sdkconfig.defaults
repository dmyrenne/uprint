# Gemeinsame Einstellungen für alle Varianten, dazu kommt sdkconfig.defaults.<variante>
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM=y

# Der native USB-Port ist USB-Host -> Konsole nur über UART0
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_FREERTOS_HZ=1000

# Lange Dateinamen, größere stdio-Puffer
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

# URL-kodierte Dateinamen in Query-Strings
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# usb_host_vcp nutzt intern C++-Exceptions
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Nach einem OTA-Update läuft die neue Firmware zur Probe; meldet sie sich nicht als gut (main.c), kehrt der
# Bootloader zur vorherigen zurück. Greift erst mit einem neuen Bootloader, also nach einmaligem Flashen per USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Auf Größe optimieren (-Os): weniger Code im internen RAM und im Flash
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
